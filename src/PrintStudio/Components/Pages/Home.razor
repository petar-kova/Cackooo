@page "/"
@inject IProductService ProductService

<PageTitle>Početna | AkrilShop</PageTitle>

<section class="hero">
    <div class="container hero-content">
        <h1>Profesionalni web shop za akrilne boje i umjetnički pribor</h1>
        <p>Premium pigmenti, brza dostava i pažljivo odabrani proizvodi za početnike, hobiste i profesionalce.</p>
        <div class="actions">
            <a class="btn btn-primary" href="/proizvodi">Kupi sada</a>
            <a class="btn btn-outline" href="/registracija">Kreiraj račun</a>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="container">
        <h2>Akcije tjedna</h2>
        <div class="products-grid">
            @foreach (var item in saleProducts)
            {
                <article class="card">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                    <span class="badge sale">Akcija</span>
                    <h3>@item.Name</h3>
                    <p>@item.Description</p>
                    <p>
                        <strong>@item.Price.ToString("0.00") €</strong>
                        @if (item.OldPrice is not null)
                        {
                            <span class="old-price">@item.OldPrice.Value.ToString("0.00") €</span>
                        }
                    </p>
                </article>
            }
        </div>
    </div>
</section>

<section class="section container">
    <h2>Najprodavaniji proizvodi</h2>
    <div class="products-grid">
        @foreach (var item in bestSellerProducts)
        {
            <article class="card">
                <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                <span class="badge bestseller">Best seller</span>
                <h3>@item.Name</h3>
                <p>@item.Description</p>
                <p><strong>@item.Price.ToString("0.00") €</strong></p>
            </article>
        }
    </div>
</section>

@code {
    private List<Product> saleProducts = [];
    private List<Product> bestSellerProducts = [];

    protected override async Task OnInitializedAsync()
    {
        saleProducts = await ProductService.GetAllAsync(onlyOnSale: true, sortBy: "price-asc");
        bestSellerProducts = await ProductService.GetAllAsync(onlyBestSeller: true, sortBy: "name-asc");
    }
}
